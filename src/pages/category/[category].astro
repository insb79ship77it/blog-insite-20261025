---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';

export function getStaticPaths() {
  return [
    { params: { category: '건강' }, props: { category: '건강' } },
    { params: { category: '생활-정보' }, props: { category: '생활 정보' } },
    { params: { category: '뉴스' }, props: { category: '뉴스' } },
    { params: { category: '기타' }, props: { category: '기타' } },
  ];
}

const { category } = Astro.props;

const allPosts = await getCollection(
  'posts',
  ({ data }) => data.draft !== true
);

const posts = allPosts
  .filter((post) => post.data.category === category)
  .sort(
    (a, b) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
---

<BaseLayout title={`${category} | 정보꾸러미 인사이트`}>
  <section class="page-heading">
    <h1>{category}</h1>
    <p>{category} 카테고리의 글을 모아 볼 수 있습니다.</p>
  </section>

  <PostList posts={posts} />
</BaseLayout>
